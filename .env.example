# Opus environment configuration
# Copy to .env for local overrides. Never commit real secrets.

# --- Database (docker-compose Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opus_db
DB_USER=opus_user
DB_PASSWORD=opus_password

# --- Application ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Security ---
# REQUIRED in production: unique secret, at least 32 characters.
JWT_SECRET=change-me-to-a-unique-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Refresh token session lifetime in minutes (default 7 days).
REFRESH_TOKEN_TTL=10080

# In-memory rate limiting for public auth endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# Google OAuth2 (required for real Google sign-in in prod).
GOOGLE_CLIENT_ID=
GOOGLE_ALLOW_MOCK_TOKENS=false

# Pepper for hashing OTP codes at rest.
OTP_PEPPER=change-me-otp-pepper

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
