# Copy to .env and fill in local/production values. Never commit .env.

# Database. Locally Flyway and the API share DB_USER.
# Production: Flyway should use DB_OWNER (opus_migrator, owns tables) and the API
# should use DB_USER (opus_app: USAGE + DML, does not own tables, no BYPASSRLS).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opus_db
DB_USER=opus_user
DB_PASSWORD=opus_password
DB_OWNER=opus_user
DB_OWNER_PASSWORD=opus_password

# Redis (rate limiting + dashboard cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTHENTICATED_LIMIT=120
RATE_LIMIT_FAIL_CLOSED=false
API_KEY_RATE_LIMIT_ENABLED=true
API_KEY_RATE_LIMIT=120
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60

# Cache
CACHE_TTL_SECONDS=45
CACHE_ENABLED=true

# Step-up re-authentication (seconds the reauthExp claim stays valid)
STEP_UP_ENABLED=true
STEP_UP_TTL_SECONDS=300

# Jobs
JOBS_ENABLED=true
REPORTING_REFRESH_MS=300000
OTP_CLEANUP_MS=3600000

# JWT / OTP
JWT_SECRET=change-me-to-a-32-plus-character-secret
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_TTL=10080
OTP_PEPPER=change-me-otp-pepper-16chars

# CORS (comma-separated). Empty disables cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_ALLOW_MOCK_TOKENS=false

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FAIL_ON_ERROR=false

# Optional
SERVER_PORT=8080
FORWARD_HEADERS_STRATEGY=none
SPRING_PROFILES_ACTIVE=dev
