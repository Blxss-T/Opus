# Opus environment configuration
# Copy to .env for local overrides. Never commit real secrets.

# --- Database (docker-compose Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opus_db
DB_USER=opus_user
DB_PASSWORD=opus_password

# --- Application ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Security ---
# REQUIRED in production: unique secret, at least 32 characters.
JWT_SECRET=change-me-to-a-unique-random-secret-at-least-32-chars
# Access token lifetime in milliseconds (default 15 minutes). Clients renew
# it with the refresh token via POST /auth/refresh.
JWT_EXPIRATION_MS=900000

# Refresh token session lifetime in minutes (default 7 days).
REFRESH_TOKEN_TTL=10080

# In-memory rate limiting for public auth endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set to "native" behind a reverse proxy/load balancer so rate limiting sees
# the real client IP; leave "none" when the app is reached directly.
FORWARD_HEADERS_STRATEGY=none

# In-memory rate limiting per API key (X-API-Key), across all endpoints.
API_KEY_RATE_LIMIT_ENABLED=true
API_KEY_RATE_LIMIT=120
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60

# Browser origins allowed to call the API (comma-separated). Dev defaults to
# http://localhost:3000 and http://localhost:5173; empty in prod blocks all.
CORS_ALLOWED_ORIGINS=

# Google OAuth2 (required for real Google sign-in in prod).
GOOGLE_CLIENT_ID=
GOOGLE_ALLOW_MOCK_TOKENS=false

# Pepper for hashing OTP codes at rest.
# REQUIRED in production: unique value, at least 16 characters.
OTP_PEPPER=change-me-otp-pepper

# --- Mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# When true, a missing mail server or failed delivery returns an error instead
# of being logged and ignored. Defaults to true in prod, false elsewhere.
MAIL_FAIL_ON_ERROR=false
